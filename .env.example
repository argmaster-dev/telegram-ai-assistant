# Скопируйте в .env и заполните. Реальный .env не коммитить.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Ваш Telegram user_id (число). Бот обрабатывает сообщения только из этого чата,
# остальные игнорируются и пишутся в лог как WARNING.
ALLOWED_CHAT_ID=your_telegram_user_id_here

# Ключ Google AI Studio. Нужен только для публичного режима (распознавание через Gemini
# после явного согласия). Если пусто, облачные функции отключены.
GEMINI_API_KEY=

# Ключ AudD.io (необязательно, распознавание музыки)
AUDD_API_KEY=

# Ключ шифрования документов: base64 от 32 случайных байт (AES-256). ОБЯЗАТЕЛЕН.
# Сгенерировать:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Храните копию ключа в менеджере паролей: без него документы не расшифровать.
DOCS_ENCRYPTION_KEY=

# Если true, вызовы Gemini и AudD полностью отключены (только локальный режим)
PRIVACY_STRICT=false

# Адреса соседних контейнеров (обычно менять не нужно)
# OLLAMA_URL=http://tg_ollama:11434
# QDRANT_URL=http://tg_qdrant:6333

# Пути внутри контейнера (монтируются из ./data)
# DB_PATH=/app/data/tg_assist.db
# DOCS_DIR=/app/data/documents
# TMP_DIR=/app/data/tmp
